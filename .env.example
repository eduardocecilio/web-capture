# Chave secreta da sessão Flask
SESSION_SECRET=your-super-secret-key-change-in-production-12345

# Banco de dados PostgreSQL (Vercel Postgres)
# Formato: postgresql://user:password@host:5432/database
POSTGRES_URL=

# Vercel Blob Storage token (opcional, para armazenar PDFs na nuvem)
# BLOB_READ_WRITE_TOKEN=

# Ambiente
FLASK_ENV=production
DEBUG=False
