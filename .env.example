# Origem permitida para CORS (sem barra no final)
CORS_ORIGIN=https://capture.ceciliolab.com

# Ambiente: "development" desabilita rate limit
NODE_ENV=production

# Docker Compose: endereço de bind (default: 0.0.0.0)
BIND_ADDRESS=127.0.0.1

# Docker Compose: porta do host (default: 3000)
HOST_PORT=3002

# Docker Compose: rede externa (default: web-capture_default)
NETWORK_NAME=infra_net
